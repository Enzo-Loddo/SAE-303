---
// Gabarit des 5 pages de questions : titre, graphique(s), réponse, précédent/suivant.
// Usage dans src/pages/xxx.astro :
//   <QuestionPage slug="evolution">  ...contenu : <Figure/> + texte...  </QuestionPage>
import Layout from "../layouts/Layout.astro";
import { QUESTIONS } from "../config/site.js";
import Parcours from "./Parcours.astro";
const { slug } = Astro.props;
const i = QUESTIONS.findIndex((q) => q.slug === slug);
const q = QUESTIONS[i];
const avant = QUESTIONS[i - 1];
const apres = QUESTIONS[i + 1];
---
<Layout title={q.question} description={q.question}>
  <div class="mx-auto max-w-2xl"><Parcours /></div>
  <p class="hero-in mt-12 text-sm font-bold uppercase tracking-widest text-accent">Question {i + 1} sur {QUESTIONS.length}</p>
  <h1 class="hero-in mt-3 max-w-3xl text-3xl font-bold leading-tight sm:text-5xl">{q.question}</h1>

  <div class="mt-6">
    <slot />
  </div>

  <nav aria-label="Autres questions" class="mt-14 flex flex-wrap justify-between gap-4 border-t border-line pt-6">
    {avant ? <a class="underline underline-offset-4" href={`/${avant.slug}`}>← {avant.menu}</a> : <span></span>}
    {apres
      ? <a class="underline underline-offset-4" href={`/${apres.slug}`}>{apres.menu} →</a>
      : <a class="underline underline-offset-4" href="/conclusion">Conclusion →</a>}
  </nav>
</Layout>
