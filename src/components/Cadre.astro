---
// Bloc d'un graphique : le TEXTE (titre, sous-titre, explication) est placé au-dessus,
// hors du cadre ; le cadre ne contient que les commandes, la légende et le graphique.
// Les scripts retrouvent leurs éléments avec  #id [data-zone], [data-titre]…
const { id, titre, sousTitre, description, alt, source } = Astro.props;
---
<section id={id} class="my-10" aria-labelledby={`${id}-titre`}>
  <header class="max-w-3xl">
    <h2 id={`${id}-titre`} data-titre class="font-serif text-2xl font-bold leading-snug sm:text-3xl">{titre}</h2>
    <p data-sous-titre class="mt-2 italic text-ink/75">{sousTitre}</p>
    <div data-description class="mt-4 leading-relaxed text-ink/90" set:html={description} />
  </header>

  <figure class="mt-6 rounded-xl border border-line bg-white p-4 shadow-sm sm:p-6">
    <div><slot name="controles" /></div>
    <div class="mt-4"><slot name="legende" /></div>

    <div data-zone class="mt-3 min-h-64 overflow-x-auto" role="group" aria-label={alt}>
      <p data-chargement class="animate-pulse text-sm text-ink/60">Chargement du graphique…</p>
      <noscript><p>Ce graphique demande JavaScript. En voici la lecture : {alt}</p></noscript>
    </div>

    <slot />

    <figcaption class="mt-4 border-t border-line pt-3 text-xs text-ink/70">Source : {source}</figcaption>
  </figure>

  <aside class="mt-5 max-w-3xl border-l-4 border-accent/40 pl-4 text-sm leading-relaxed" aria-label="Lecture du graphique">
    <p><strong>Lecture du graphique.</strong> {alt}</p>
    <slot name="notes" />
  </aside>
</section>
