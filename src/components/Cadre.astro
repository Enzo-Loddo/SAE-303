---
const { id, titre, sousTitre, description, alt, source, guide = [] } = Astro.props;
---
<section id={id} class="my-10" aria-labelledby={`${id}-titre`}>
  <header class="max-w-3xl">
    <h2 id={`${id}-titre`} data-titre class="font-serif text-2xl font-bold leading-snug sm:text-3xl">{titre}</h2>
    <p data-sous-titre class="mt-2 italic text-ink/80">{sousTitre}</p>
    <div data-description class="mt-4 leading-relaxed text-ink/90" set:html={description} />
  </header>

  <figure class="mt-6 rounded-xl border border-line bg-white p-4 shadow-sm sm:p-6">
    <div><slot name="controles" /></div>
    <div class="mt-4"><slot name="legende" /></div>

    <div data-zone data-alt={alt} class="mt-3 min-h-64 overflow-x-auto">
      <p data-chargement class="animate-pulse text-sm text-ink/80">Chargement du graphique…</p>
      <noscript><p>Ce graphique demande JavaScript. En voici la lecture : {alt}</p></noscript>
    </div>

    <slot />

    <figcaption class="mt-4 border-t border-line pt-3 text-xs text-ink/80">Source : {source} · données consultées en octobre 2026</figcaption>
  </figure>

  <aside class="mt-6" aria-label="Lecture du graphique">
    <h3 class="font-serif text-lg font-bold">Lire ce graphique en trois points</h3>
    <ol class="mt-3 grid gap-3 md:grid-cols-3">
      {guide.map((g, i) => (
        <li class="rounded-lg border border-line bg-sable/60 p-4">
          <span class="flex items-center gap-2 text-sm font-bold text-accent"><span class="grid h-6 w-6 place-items-center rounded-full bg-accent text-xs text-paper">{i + 1}</span>{g.t}</span>
          <span class="mt-2 block text-sm leading-relaxed" set:html={g.d} />
        </li>
      ))}
    </ol>
    <details class="mt-3 text-sm">
      <summary class="cursor-pointer font-bold text-accent underline-offset-4 hover:underline">Description détaillée (texte alternatif)</summary>
      <p class="mt-2 max-w-3xl leading-relaxed">{alt}</p>
      <slot name="notes" />
    </details>
  </aside>
</section>
