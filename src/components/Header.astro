---
import { SITE, MENU, QUESTIONS } from "../config/site.js";
// Page courante, sans slash final, pour marquer le lien actif.
const actuel = Astro.url.pathname.replace(/\/$/, "") || "/";
const dansQuestions = QUESTIONS.some((q) => actuel === `/${q.slug}`);
const lien = "underline-offset-4 hover:underline aria-[current=page]:font-bold aria-[current=page]:underline";
---
<header class="border-b border-line bg-white">
  <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-6 gap-y-3 px-4 py-3">
    <a href="/" class="flex items-center gap-3 font-serif text-xl font-bold text-accent">
      <img src="/logo.svg" width="36" height="36" alt="" />
      <span>{SITE.nom}</span>
    </a>
    <nav aria-label="Navigation principale">
      <ul class="flex flex-wrap items-center gap-x-6 gap-y-2">
        {MENU.map((item) =>
          item.questions ? (
            <li class="relative">
              <details id="menu-questions" class="group">
                <summary
                  class:list={[
                    "flex cursor-pointer list-none items-center gap-1 underline-offset-4 hover:underline [&::-webkit-details-marker]:hidden",
                    dansQuestions && "font-bold underline",
                  ]}
                >
                  {item.label}
                  <span aria-hidden="true" class="text-xs transition-transform group-open:rotate-180">▾</span>
                </summary>
                <ul class="absolute left-0 z-40 mt-2 w-72 max-w-[calc(100vw-2rem)] rounded border border-line bg-white p-2 shadow-lg sm:left-auto sm:right-0">
                  {QUESTIONS.map((q) => (
                    <li>
                      <a
                        href={`/${q.slug}`}
                        aria-current={actuel === `/${q.slug}` ? "page" : undefined}
                        class="block rounded px-3 py-2 hover:bg-paper aria-[current=page]:bg-paper aria-[current=page]:font-bold"
                      >
                        <span class="block text-sm font-bold text-accent">{q.menu}</span>
                        <span class="block text-sm">{q.question}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            </li>
          ) : (
            <li>
              <a href={item.href} aria-current={actuel === item.href ? "page" : undefined} class={lien}>
                {item.label}
              </a>
            </li>
          ),
        )}
      </ul>
    </nav>
  </div>
</header>

<script>
  // Menu déroulant : se ferme avec Échap ou un clic à l'extérieur.
  const menu = document.getElementById("menu-questions");
  if (menu) {
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && menu.open) {
        menu.open = false;
        menu.querySelector("summary")?.focus();
      }
    });
    document.addEventListener("click", (e) => {
      if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
    });
  }
</script>
