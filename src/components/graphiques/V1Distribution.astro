---
import Cadre from "../Cadre.astro";
import Choix from "../Choix.astro";
import tm from "../../data/anomalies-temperature.json";
const [a0, a1] = [Math.min(...tm.map((d) => d.annee)), Math.max(...tm.map((d) => d.annee))];
const territoires = [
  { value: "Martinique", label: "Martinique", couleur: "#0072B2" },
  { value: "La Réunion", label: "La Réunion", couleur: "#D55E00" },
  { value: "Nouvelle-Calédonie", label: "Nouvelle-Calédonie", couleur: "#009E73" },
];
---
<Cadre
  guide={[{"t": "Ce qu'on regarde", "d": "Chaque <b>point</b> est une année, chaque <b>rangée</b> un territoire. Plus un point est à droite, plus l'année a été chaude par rapport à la moyenne 1991-2020."}, {"t": "Comment le lire", "d": "Les points sont <b>clairs</b> pour les années anciennes et <b>foncés</b> pour les récentes. Les points cerclés de noir sont les années les plus chaudes de la rangée."}, {"t": "Ce qu'il faut retenir", "d": "Les points cerclés sont presque tous foncés : <b>les années les plus chaudes sont récentes</b>. Les curseurs et cases permettent de restreindre la période ou les territoires."}]}
  id="v1"
  titre="Les années les plus chaudes sont presque toutes récentes"
  sousTitre="Écart de chaque année à la moyenne 1991-2020, en °C"
  description="Chaque point est une année : plus il est <b>à droite</b>, plus l'année a été chaude ; plus il est <b>foncé</b>, plus elle est récente. Les points <b>cerclés de noir</b> sont les années les plus chaudes de la période dans chaque territoire : ils sont presque tous foncés, donc récents. Les filtres permettent de n'afficher qu'un territoire ou qu'une période."
  alt="Trois rangées de points, une par territoire. Dans chacune, les points clairs des années 70 et 80 sont à gauche (jusqu'à 1,2 °C sous la moyenne 1991-2020) et les points foncés des années 2010 et 2020 à droite. Les 10 années les plus chaudes datent toutes de 1998 ou après en Martinique (record 2024 : +1,47 °C), de 2010 ou après à La Réunion (record 2019 : +0,91 °C) et de 1988 ou après en Nouvelle-Calédonie (record 2022 : +1,27 °C)."
  source="Météo-France, séries longues homogénéisées (TN et TX), calculs du groupe 14"
>
  <div slot="controles" class="space-y-5">
    <Choix legende="Territoires affichés" name="v1-territoires" type="checkbox" options={territoires} valeur={territoires.map((t) => t.value)} />
    <div class="grid max-w-xl gap-4 sm:grid-cols-2">
      <label class="block text-sm">
        <span class="font-bold">De l'année <output id="v1-debut-val" class="font-normal">{a0}</output></span>
        <input id="v1-debut" type="range" min={a0} max={a1} step="1" value={a0} class="mt-2 w-full accent-accent" />
      </label>
      <label class="block text-sm">
        <span class="font-bold">À l'année <output id="v1-fin-val" class="font-normal">{a1}</output></span>
        <input id="v1-fin" type="range" min={a0} max={a1} step="1" value={a1} class="mt-2 w-full accent-accent" />
      </label>
    </div>
  </div>
  <ul data-resume class="mt-4 space-y-1 text-sm" aria-live="polite"></ul>
</Cadre>

<script>
  import tm from "../../data/anomalies-temperature.json";
  import { graphiqueDistribution, fmtC, COULEURS } from "../../lib/graphiques.js";
  import { auVisible, largeurDe, surLargeur, afficher } from "../../lib/monter.js";

  const fig = document.getElementById("v1");
  const zone = fig.querySelector("[data-zone]");
  const resume = fig.querySelector("[data-resume]");
  const sousTitre = fig.querySelector("[data-sous-titre]");
  const debutEl = document.getElementById("v1-debut");
  const finEl = document.getElementById("v1-fin");

  function dessiner() {
    const territoires = [...fig.querySelectorAll('input[name="v1-territoires"]:checked')].map((i) => i.value);
    const debut = Math.min(+debutEl.value, +finEl.value);
    const fin = Math.max(+debutEl.value, +finEl.value);
    document.getElementById("v1-debut-val").textContent = String(debut);
    document.getElementById("v1-fin-val").textContent = String(fin);
    if (territoires.length === 0) {
      zone.innerHTML = '<p class="italic">Coche au moins un territoire.</p>';
      resume.innerHTML = "";
      return;
    }
    const r = graphiqueDistribution(tm, { width: largeurDe(zone, 560), territoires, debut, fin });
    const legende = document.createElement("div");
    legende.className = "mb-2";
    legende.append(r.legende);
    afficher(zone, legende, r.plot);
    sousTitre.textContent = `Écart de chaque année à la moyenne 1991-2020, en °C · ${territoires.join(", ")} · ${debut}-${fin}`;
    resume.innerHTML = r.resume
      .map((x) => `<li><span class="mr-2 inline-block h-2.5 w-2.5 rounded-full" style="background:${COULEURS[x.t]}"></span><b>${x.t}</b> : les ${r.nTop} années les plus chaudes datent toutes de ${x.depuis} ou après ; record en ${x.record.annee} (${fmtC(x.record.anomalie)}).</li>`)
      .join("");
  }

  auVisible(zone, () => {
    dessiner();
    fig.addEventListener("input", dessiner);
    surLargeur(zone, dessiner);
  });
</script>
