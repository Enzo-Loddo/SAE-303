---
import Layout from "../layouts/Layout.astro";
import { SITE, TERRITOIRES, QUESTIONS } from "../config/site.js";

---
<Layout>

  <section aria-labelledby="titre-page" class="mx-auto max-w-3xl pt-4 text-center sm:pt-10">
    <p class="hero-in text-sm font-bold uppercase tracking-widest text-accent">Enquête · données Météo-France</p>
    <h1 id="titre-page" class="hero-in mt-4 text-3xl font-bold leading-tight sm:text-5xl">{SITE.question}</h1>
    <p class="hero-in mx-auto mt-6 max-w-2xl text-lg leading-relaxed">

      Trois îles, trois océans, un même mot : « réchauffement ». Cette enquête compare ce que disent
      réellement les mesures de Météo-France pour chacune. <em>[À COMPLÉTER : accroche pour le public choisi]</em>
    </p>
    <p class="hero-in mt-8"><a href="/repartition" class="inline-block rounded-full bg-accent px-6 py-3 font-bold text-paper transition hover:-translate-y-0.5 hover:shadow-lg">Commencer le parcours →</a></p>
  </section>

  <section aria-label="Les données en chiffres" class="mt-16">
    <ul class="grid grid-cols-2 gap-4 sm:grid-cols-4">
      {[["3", "territoires"], ["22", "stations météo"], ["55", "ans de mesures (1970-2024)"], ["5", "questions"]].map(([n, l]) => (
        <li class="reveal rounded-xl border border-line bg-white p-4 text-center shadow-sm">
          <span data-compte={n} class="block font-serif text-4xl font-bold text-accent">{n}</span>
          <span class="mt-1 block text-sm text-ink/80">{l}</span>
        </li>
      ))}
    </ul>
  </section>

  <section aria-labelledby="titre-territoires" class="mt-20">
    <h2 id="titre-territoires" class="text-center text-2xl font-bold sm:text-3xl">Trois territoires</h2>
    <ul class="mt-6 grid gap-6 sm:grid-cols-3">
      {TERRITOIRES.map((t, i) => (
        <li class="reveal" style={`--d:${i * 200}ms`}>
          <figure tabindex="0" aria-describedby={`info-${t.id}`} class="carte-territoire relative flex h-full flex-col items-center rounded-lg border border-line bg-white px-4 pb-5 pt-4 text-center">
            <img
              src={t.image}
              alt={`Silhouette de ${t.nom}`}
              width="480"
              height="480"
              class="silhouette aspect-square w-full max-w-56 object-contain"
            />
            <figcaption class="mt-2">
              <span class="block font-serif text-lg font-bold">{t.nom}</span>
              <span class="block text-sm text-ink/80">{t.ocean}</span>
              <span class="mt-2 block text-sm text-ink/80">Il est <strong data-heure={t.fuseau}>--:--</strong> là-bas ({t.utc})</span>
              <span class="mx-auto mt-3 block h-1.5 w-12 rounded" style={`background:${t.couleur}`} aria-hidden="true"></span>
            </figcaption>
            <div id={`info-${t.id}`} class="infobulle absolute inset-2 flex flex-col justify-center rounded-lg p-4 text-left text-sm leading-snug text-paper" style="background:rgba(43,29,22,0.94)">
              <p class="font-serif text-base font-bold text-sun">{t.nom}</p>
              <ul class="mt-2 space-y-2">
                {t.faits.map((x) => <li class="flex gap-2"><span aria-hidden="true" class="text-sun">●</span><span>{x}</span></li>)}
              </ul>
            </div>
          </figure>
        </li>
      ))}
    </ul>
  </section>

  <section aria-labelledby="titre-questions" class="mt-20">
    <h2 id="titre-questions" class="text-2xl font-bold sm:text-3xl">Cinq questions, cinq réponses</h2>
    <ol class="mt-6 max-w-3xl space-y-3">
      {QUESTIONS.map((q) => (
        <li><a class="group flex items-start gap-4 rounded-xl border border-line bg-white p-4 transition hover:border-accent hover:shadow" href={`/${q.slug}`}><span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-accent text-sm font-bold text-paper">{QUESTIONS.indexOf(q) + 1}</span><span class="pt-0.5">{q.question}</span></a></li>
      ))}
    </ol>
    <p class="mt-4 max-w-3xl text-sm text-ink/80">
      Chaque question a sa page, accessible depuis le menu « Les questions », avec un graphique et sa réponse. La page Conclusion les rassemble.
    </p>
  </section>

  <section aria-labelledby="titre-recit" class="mt-20">
    <h2 id="titre-recit" class="text-2xl font-bold sm:text-3xl">Le récit en quatre temps</h2>
    <ol class="mt-6 grid gap-4 sm:grid-cols-2">
      <li class="rounded-xl border border-line bg-white p-5"><span class="text-sm font-bold uppercase tracking-widest text-accent">1 · Contexte</span><strong class="mt-1 block font-serif text-lg">Trois îles, un même mot : « réchauffement »</strong><span class="mt-1 block text-sm text-ink/80">D'où viennent les données et pourquoi comparer les territoires. Voir la page <a class="underline underline-offset-4" href="/methode">Méthode</a>.</span></li>
      <li class="rounded-xl border border-line bg-white p-5"><span class="text-sm font-bold uppercase tracking-widest text-accent">2 · Exploration</span><strong class="mt-1 block font-serif text-lg">Des records récents, mais pas partout au même rythme</strong><span class="mt-1 block text-sm text-ink/80">Les années chaudes (<a class="underline underline-offset-4" href="/repartition">question 1</a>) puis les écarts à l'intérieur de chaque île (<a class="underline underline-offset-4" href="/carte">question 2</a>).</span></li>
      <li class="rounded-xl border border-line bg-white p-5"><span class="text-sm font-bold uppercase tracking-widest text-accent">3 · Révélation</span><strong class="mt-1 block font-serif text-lg">Le plus rapide hier n'est pas forcément celui qui montera le plus</strong><span class="mt-1 block text-sm text-ink/80">Le rythme depuis 1970, l'écart en 2050 et la pluie qui ne suit pas : <a class="underline underline-offset-4" href="/evolution">3</a>, <a class="underline underline-offset-4" href="/futur">4</a> et <a class="underline underline-offset-4" href="/pluie">5</a>.</span></li>
      <li class="rounded-xl border border-line bg-white p-5"><span class="text-sm font-bold uppercase tracking-widest text-accent">4 · Conclusion</span><strong class="mt-1 block font-serif text-lg">Même mot, pas la même réalité</strong><span class="mt-1 block text-sm text-ink/80">Les réponses, ce qu'elles changent, et leurs limites : <a class="underline underline-offset-4" href="/conclusion">la conclusion</a>.</span></li>
    </ol>
  </section>

  <script>
    const compteurs = document.querySelectorAll<HTMLElement>("[data-compte]");
    const reduit = matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!reduit && "IntersectionObserver" in window) {
      const obs = new IntersectionObserver((es) => es.forEach((e) => {
        if (!e.isIntersecting) return;
        obs.unobserve(e.target);
        const el = e.target as HTMLElement, fin = Number(el.dataset.compte), t0 = performance.now();
        const pas = (t: number) => {
          const k = Math.min(1, (t - t0) / 1200);
          el.textContent = String(Math.round(fin * (1 - Math.pow(1 - k, 3))));
          if (k < 1) requestAnimationFrame(pas);
        };
        requestAnimationFrame(pas);
      }), { threshold: 0.6 });
      compteurs.forEach((c) => obs.observe(c));
    }
  </script>
</Layout>
