---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE } from "../config/site.js";

const { title, description = SITE.description } = Astro.props;
const titreComplet = title ? `${title} · ${SITE.nom}` : SITE.nom;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{titreComplet}</title>
    <!-- Animations activées seulement si le visiteur ne demande pas de mouvement réduit -->
    <script is:inline>
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) document.documentElement.classList.add("js");
    </script>
  </head>
  <body id="haut" class="flex min-h-screen flex-col">
    <a
      href="#contenu"
      class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:z-50 focus:bg-white focus:p-3"
    >Aller au contenu</a>
    <Header />
    <main id="contenu" class="mx-auto w-full max-w-5xl flex-1 px-4 py-10">
      <slot />
    </main>
    <Footer />
    <script>
      // Apparition progressive : chaque section (ou élément .reveal) s'anime quand il entre à l'écran.
      const cibles = document.querySelectorAll<HTMLElement>("main section, .reveal");
      cibles.forEach((el) => el.classList.add("reveal"));
      if ("IntersectionObserver" in window) {
        const obs = new IntersectionObserver(
          (entrees) =>
            entrees.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add("visible");
                obs.unobserve(e.target);
              }
            }),
          { threshold: 0.15 },
        );
        cibles.forEach((el) => obs.observe(el));
      } else {
        cibles.forEach((el) => el.classList.add("visible"));
      }
    </script>
  </body>
</html>
